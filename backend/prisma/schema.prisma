// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  //url = env("DATABASE_URL")
}

//MODELS

model User {
  id String @id @default(uuid()) // should change to cuid()
  name String @unique
  pass String
  apartments Apartment[]
  buildings Building[]
}

model Building{
  id String @id @default(uuid())
  strAddress String
  strNum Int
  floors Int
  apartments Apartment[]
  expenses Expense[]
  expenseCategories ExpenseCategory[]
  adminId String
  admin User @relation(fields: [adminId], references: [id])
}

model Apartment {
  id String @id @default(uuid())
  area Int
  floor Int
  doorNum Int
  //floor and doorNum should be unique
  bills Bill[]
  buildingId String
  building Building @relation(fields:[buildingId], references: [id])
  ownerId String?
  owner User? @relation(fields:[ownerId], references: [id])
}

model Bill{
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  paid Boolean @default(false)
  amount Decimal @db.Decimal(8,2)
  aptId String
  apt Apartment @relation(fields: [aptId], references: [id])
  expenseReportId String
  expenseReport ExpenseReport @relation(fields: [expenseReportId], references: [id])
}

model ExpenseCategory{
  id Int @id @default(autoincrement())
  name String @unique // WATER, ELECTRICITY etc
  buildingId String
  building Building @relation(fields: [buildingId], references: [id])
  areaWeight Decimal @db.Decimal(8,3) @default(1.0) 
  floorWeight Decimal @db.Decimal(8,3) @default(1.0)
  expenses Expense[]
}

model Expense{
  id String @id @default(uuid())
  categoryId Int
  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  description String 
  issuedAt DateTime @default(now())
  paid Boolean @default(false)
  amount Decimal @db.Decimal(8,2)
  buildingId String
  building Building @relation(fields: [buildingId], references: [id])
  expenseReportId String?
  expenseReport ExpenseReport? @relation(fields: [expenseReportId], references: [id])
}

model ExpenseReport{
  id String @id @default(uuid())
  expenses Expense[]
  bills Bill[]
}